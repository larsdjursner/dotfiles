
# apperance
theme = dark:Catppuccin Frappe,light:Catppuccin Latte
background-opacity = 0.90
background-blur-radius = 40
cursor-style-blink = false
cursor-invert-fg-bg = true
mouse-hide-while-typing = true

# macOS-specific settings
macos-titlebar-style = tabs
macos-option-as-alt = true

unfocused-split-opacity = 0.97

# window controls
confirm-close-surface = true
# window-title-font-family = VictorMono NFM Italic
window-decoration = true
window-padding-x = 2
window-padding-y = 2
window-padding-balance = true
window-save-state = always

# auto update settings
auto-update = download
auto-update-channel = stable

# notifications
bell-features = system

# extras
shell-integration-features = true
copy-on-select = clipboard
focus-follows-mouse = true
link-url = true

# macOS-native text editing
keybind = super+left=text:\x01
keybind = super+right=text:\x05
keybind = super+backspace=text:\x15
keybind = super+delete=text:\x0b
keybind = super+z=undo
keybind = super+shift+z=redo

# custom keybindings
keybind = ctrl+shift+w=close_surface
keybind = super+w=close_surface
keybind = super+r=reload_config 
keybind = super+i=inspector:toggle
keybind = super+f=start_search

# extra tab navigation
keybind = super+k=previous_tab
keybind = super+l=next_tab

# splits
keybind = super+b>n=new_split:right
keybind = super+b>m=new_split:down
keybind = super+b>e=equalize_splits
keybind = super+b>z=toggle_split_zoom
keybind = super+b>x=close_surface

# split navigation 
keybind = super+b>h=goto_split:left
keybind = super+b>j=goto_split:bottom
keybind = super+b>k=goto_split:top
keybind = super+b>l=goto_split:right
keybind = super+b>left=goto_split:left
keybind = super+b>down=goto_split:bottom
keybind = super+b>up=goto_split:top
keybind = super+b>right=goto_split:right

# gtab managed include
config-file = "/Users/ldr/.config/gtab/ghostty-shortcut.conf"
