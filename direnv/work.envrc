# Linked to ~/Documents/ix/.envrc. Uses the work gh account in this shell only,
# without touching gh's globally active (personal) account.
dotenv_if_exists "$HOME/dotfiles/direnv/work.env"

if [ -n "$GH_WORK_ACCOUNT" ]; then
    export GH_TOKEN=$(gh auth token -u "$GH_WORK_ACCOUNT")
    export GH_ACCOUNT=$GH_WORK_ACCOUNT
fi
