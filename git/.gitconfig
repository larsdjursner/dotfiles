[user]
    name = larsdjursner
	email = 40217101+larsdjursner@users.noreply.github.com

[includeIf "gitdir:~/Documents/ix/"]
    path = ~/.gitconfig.work

[core]
    editor = code --wait      # VS Code as default editor
    autocrlf = input          # sensible for Mac

[init]
    defaultBranch = main

[merge]
    conflictstyle = diff3     # shows base in conflict markers, very helpful

[diff]
    algorithm = histogram     # generally better diffs than default myers

[alias]
    lg = log --oneline --graph --decorate --all
    undo = reset --soft HEAD~1
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
